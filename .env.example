# Copy to .env and replace all placeholders, or run scripts/configure.ps1.
POSTGRES_PASSWORD=replace-with-a-random-database-password
ADMIN_PASSWORD=replace-with-a-unique-admin-password
INGEST_KEY=replace-with-a-random-ingest-key
CHECKPOINT_SIGNING_KEY=replace-with-a-random-checkpoint-key
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
RETENTION_DAYS=30
